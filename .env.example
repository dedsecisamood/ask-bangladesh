# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ask_bangladesh
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ask_bangladesh

# AI / LLM Configuration
AI_PROVIDER=openai
OPENAI_API_KEY=sk-placeholder-key-for-development
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Security & Sessions
ADMIN_JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
ADMIN_DEFAULT_PASSWORD=admin-secure-password-change-me

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
